set xs = []
set ys = []
set vxs = []
set vys = []
set i = 0
while i < 20000:
    push(xs, i * 1.0)
    push(ys, i * 1.0)
    push(vxs, 1.5)
    push(vys, -0.5)
    i = i + 1
set frame = 0
while frame < 200:
    set j = 0
    while j < 20000:
        xs[j] = xs[j] + vxs[j]
        ys[j] = ys[j] + vys[j]
        j = j + 1
    frame = frame + 1
set total = 0.0
set k = 0
while k < 20000:
    total = total + xs[k]
    k = k + 1
say floor(total)
