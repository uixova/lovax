# JIT list-index torture — self-verifying. Five independent sort algorithms plus
# search/matrix kernels, all built on heavy INDEX_GET/INDEX_SET in hot loops
# (exactly the unboxed-storage + JIT-index path). Each result is checked for the
# sorted invariant AND multiset preservation (sum + xor fingerprint), and every
# algorithm must agree with the others — a JIT index miscompile breaks a value
# and trips check(). Identical under --jit and --no-jit.

# ---- deterministic pseudo-random list (MINSTD LCG) ----
fn make_list(n, seed):
    set xs = []
    set s = seed
    set i = 0
    while i < n:
        s = (s * 48271) % 2147483647
        push(xs, s % 100000)
        i = i + 1
    return xs

fn copy_list(xs):
    set out = []
    set i = 0
    while i < len(xs):
        push(out, xs[i])
        i = i + 1
    return out

fn is_sorted(xs):
    set i = 1
    while i < len(xs):
        if xs[i - 1] > xs[i]:
            return false
        i = i + 1
    return true

# order-independent fingerprint: sum + xor of all elements
fn fingerprint(xs):
    set s = 0
    set x = 0
    set i = 0
    while i < len(xs):
        s = s + xs[i]
        x = x ^ xs[i]
        i = i + 1
    return [s, x]

fn same_fp(a, b):
    return a[0] == b[0] and a[1] == b[1]

# ---- bubble sort ----
fn bubble(xs):
    set n = len(xs)
    set i = 0
    while i < n:
        set j = 0
        while j < n - 1 - i:
            if xs[j] > xs[j + 1]:
                set tmp = xs[j]
                xs[j] = xs[j + 1]
                xs[j + 1] = tmp
            j = j + 1
        i = i + 1
    return xs

# ---- insertion sort ----
fn insertion(xs):
    set i = 1
    while i < len(xs):
        set key = xs[i]
        set j = i - 1
        while j >= 0 and xs[j] > key:
            xs[j + 1] = xs[j]
            j = j - 1
        xs[j + 1] = key
        i = i + 1
    return xs

# ---- selection sort ----
fn selection(xs):
    set n = len(xs)
    set i = 0
    while i < n:
        set lo = i
        set j = i + 1
        while j < n:
            if xs[j] < xs[lo]:
                lo = j
            j = j + 1
        set tmp = xs[i]
        xs[i] = xs[lo]
        xs[lo] = tmp
        i = i + 1
    return xs

# ---- in-place quicksort (explicit stack, no recursion depth worries) ----
fn quick(xs):
    set n = len(xs)
    if n < 2:
        return xs
    set stack = [0, n - 1]
    while len(stack) > 0:
        set hi = pop(stack)
        set lo = pop(stack)
        if lo >= hi:
            continue
        set pivot = xs[hi]
        set p = lo
        set k = lo
        while k < hi:
            if xs[k] < pivot:
                set tmp = xs[p]
                xs[p] = xs[k]
                xs[k] = tmp
                p = p + 1
            k = k + 1
        set tmp2 = xs[p]
        xs[p] = xs[hi]
        xs[hi] = tmp2
        push(stack, lo)
        push(stack, p - 1)
        push(stack, p + 1)
        push(stack, hi)
    return xs

# ---- merge sort (bottom-up, index based) ----
fn merge_sort(xs):
    set n = len(xs)
    set width = 1
    set src = xs
    while width < n:
        set dst = []
        set i = 0
        while i < n:
            set l = i
            set mid = i + width
            if mid > n:
                mid = n
            set r = i + 2 * width
            if r > n:
                r = n
            set a = l
            set b = mid
            while a < mid or b < r:
                if b >= r:
                    push(dst, src[a])
                    a = a + 1
                else:
                    if a >= mid:
                        push(dst, src[b])
                        b = b + 1
                    else:
                        if src[a] <= src[b]:
                            push(dst, src[a])
                            a = a + 1
                        else:
                            push(dst, src[b])
                            b = b + 1
            i = i + 2 * width
        src = dst
        width = width * 2
    return src

# ---- run every sort against the same input, cross-check all outputs ----
set base = make_list(1200, 987654321)
set fp0 = fingerprint(base)

set r_bubble = bubble(copy_list(base))
set r_insert = insertion(copy_list(base))
set r_select = selection(copy_list(base))
set r_quick = quick(copy_list(base))
set r_merge = merge_sort(copy_list(base))

check(is_sorted(r_bubble), "bubble sorted")
check(is_sorted(r_insert), "insertion sorted")
check(is_sorted(r_select), "selection sorted")
check(is_sorted(r_quick), "quick sorted")
check(is_sorted(r_merge), "merge sorted")

check(same_fp(fingerprint(r_bubble), fp0), "bubble multiset")
check(same_fp(fingerprint(r_insert), fp0), "insertion multiset")
check(same_fp(fingerprint(r_select), fp0), "selection multiset")
check(same_fp(fingerprint(r_quick), fp0), "quick multiset")
check(same_fp(fingerprint(r_merge), fp0), "merge multiset")

# every algorithm must produce the exact same ordering
set idx = 0
while idx < len(base):
    check(r_bubble[idx] == r_insert[idx], "bubble==insert")
    check(r_bubble[idx] == r_select[idx], "bubble==select")
    check(r_bubble[idx] == r_quick[idx], "bubble==quick")
    check(r_bubble[idx] == r_merge[idx], "bubble==merge")
    idx = idx + 1

say "all sorts agree, n =", len(base)

# ---- binary search on the sorted list ----
fn bsearch(xs, target):
    set lo = 0
    set hi = len(xs) - 1
    while lo <= hi:
        set mid = (lo + hi) // 2
        if xs[mid] == target:
            return mid
        if xs[mid] < target:
            lo = mid + 1
        else:
            hi = mid - 1
    return -1

# every element must be findable at a position holding its value
set found = 0
set i = 0
while i < len(r_quick):
    set pos = bsearch(r_quick, r_quick[i])
    check(pos >= 0, "bsearch found")
    check(r_quick[pos] == r_quick[i], "bsearch value")
    found = found + 1
    i = i + 1
say "bsearch verified:", found

# ---- integer matrix multiply, checked against A * I == A ----
fn ident(n):
    set m = []
    set i = 0
    while i < n:
        set row = []
        set j = 0
        while j < n:
            if i == j:
                push(row, 1)
            else:
                push(row, 0)
            j = j + 1
        push(m, row)
        i = i + 1
    return m

fn matmul(a, b, n):
    set c = []
    set i = 0
    while i < n:
        set row = []
        set j = 0
        while j < n:
            set s = 0
            set k = 0
            while k < n:
                s = s + a[i][k] * b[k][j]
                k = k + 1
            push(row, s)
            j = j + 1
        push(c, row)
        i = i + 1
    return c

set nn = 12
set A = []
set si = 7
set i = 0
while i < nn:
    set row = []
    set j = 0
    while j < nn:
        si = (si * 48271) % 2147483647
        push(row, si % 50)
        j = j + 1
    push(A, row)
    i = i + 1

set AI = matmul(A, ident(nn), nn)
set i = 0
while i < nn:
    set j = 0
    while j < nn:
        check(AI[i][j] == A[i][j], "A*I==A")
        j = j + 1
    i = i + 1
say "matmul identity ok, n =", nn

say "73 ok"
