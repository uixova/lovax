# JIT traceable allocation (Stage-9 RFC-027) — self-verifying. A small list
# literal `[a, b, c]` built inside a hot loop no longer declines the trace: it is
# allocated in native code via a helper (gcAlloc never collects mid-call, so the
# trace's LOOP back-edge remains the GC safepoint), and the reassigned `tmp` base
# is reloaded + obj/LIST-guarded per use. Results must stay bit-identical to the
# interpreter, and the churned garbage must be collected without corruption.

# ---- int elements, fresh 3-list per iteration, read two slots ----
set sink = 0
set i = 0
while i < 20000:
    set tmp = [i, i + 1, i + 2]
    sink = sink + tmp[0] + tmp[2]
    i = i + 1
# sum over i of (i + (i+2)) = sum(2i+2) = 2*sum(i) + 2*N
check(sink == 2 * (19999 * 20000 / 2) + 2 * 20000, "int list literal per iteration")

# ---- float elements ----
set fs = 0.0
set j = 0
while j < 10000:
    set v = [j * 1.0, j * 0.5]
    fs = fs + v[0] - v[1]
    j = j + 1
# sum of (j - j*0.5) = sum(j*0.5) = 0.5 * sum(j)
check(fs == 0.5 * (9999.0 * 10000.0 / 2.0), "float list literal per iteration")

# ---- mixed sizes 1..8 (native-stack buffer boundary) ----
set c = 0
set k = 0
while k < 8000:
    set a = [k, k, k, k, k, k, k, k]      # 8 elements (buffer cap)
    c = c + a[7]
    k = k + 1
check(c == 7999 * 8000 / 2, "8-element list literal (buffer cap)")

# ---- nested list literals ----
set ns = 0
set m = 0
while m < 6000:
    set pair = [[m, m + 1], [m + 2, m + 3]]
    set lo = pair[0]
    set hi = pair[1]
    ns = ns + lo[0] + hi[1]
    m = m + 1
# sum of (m + (m+3)) = sum(2m+3)
check(ns == 2 * (5999 * 6000 / 2) + 3 * 6000, "nested list literals")
say "94 ok"
