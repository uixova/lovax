# JIT op-coverage (Stage-9): compound-assignment KEEP ops + unary NEGATE. A game
# updates array elements and struct fields in place (`arr[i] += x`, `e.hp -= 1`)
# and negates values (`-v`); these ops must trace, not decline, and stay
# bit-identical to the interpreter.

# ---- compound assign on a float list (INDEX_GET_KEEP + INDEX_SET) ----
set arr = []
set i = 0
while i < 2000:
    push(arr, i * 1.0)
    i = i + 1
set f = 0
while f < 50:
    set j = 0
    while j < 2000:
        arr[j] += 3.0
        arr[j] -= 1.0
        j = j + 1
    f = f + 1
set s = 0.0
set k = 0
while k < 2000:
    s = s + arr[k]
    k = k + 1
# each frame nets +2 per element: arr[j] = j + 100
check(s == (1999.0 * 2000.0 / 2.0) + 2000.0 * 100.0, "float compound assign a[i] += / -=")

# ---- compound assign on a struct field (MEMBER_GET_KEEP + MEMBER_SET) ----
struct Ent:
    hp = 0
    x = 0.0
set e = Ent(1000, 0.0)
set n = 0
while n < 5000:
    e.hp -= 1
    e.x += 0.5
    n = n + 1
check(e.hp == 1000 - 5000, "int field compound assign e.hp -= 1")
check(e.x == 5000.0 * 0.5, "float field compound assign e.x += 0.5")

# ---- unary NEGATE, int and float ----
set si = 0
set sf = 0.0
set m = 0
while m < 3000:
    si = si + (-m)
    sf = sf + (-(m * 1.0))
    m = m + 1
check(si == -(2999 * 3000 / 2), "int unary negate")
check(sf == -(2999.0 * 3000.0 / 2.0), "float unary negate")
say "95 ok"
