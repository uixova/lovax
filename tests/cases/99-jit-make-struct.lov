# JIT op-coverage (Stage-9, spawn Part 2): struct construction P(...). A hot loop
# that builds struct instances no longer declines — a full constructor call (every
# field provided, no defaults) allocates the instance directly in native code,
# filling its unboxed-Value slots in shape order, skipping the auto-generated
# constructor body. Must stay bit-identical to the interpreter.
struct Vec:
    x = 0.0
    y = 0.0
    hp = 0

set sx = 0.0
set sy = 0.0
set sh = 0
set i = 0
while i < 40000:
    set p = Vec(i * 1.0, i * 0.5, 100 - i)
    sx = sx + p.x
    sy = sy + p.y
    sh = sh + p.hp
    i = i + 1
check(sx == (39999.0 * 40000.0 / 2.0), "constructed float field x")
check(sy == (39999.0 * 40000.0 / 2.0) * 0.5, "constructed float field y")
check(sh == 40000 * 100 - (39999 * 40000 / 2), "constructed int field hp")

# nested: construct + mutate the fresh instance's field, then read
set acc = 0.0
set k = 0
while k < 10000:
    set q = Vec(k * 1.0, 0.0, 0)
    q.x += 5.0
    acc = acc + q.x
    k = k + 1
check(acc == (9999.0 * 10000.0 / 2.0) + 10000.0 * 5.0, "construct then compound-assign field")
say "99 ok"
